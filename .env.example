# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Application
NEXT_PUBLIC_APP_NAME=CineHub Global
NEXT_PUBLIC_APP_URL=https://cinehub-global.com
NODE_ENV=production

# Payment Gateways
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
MERCADO_PAGO_TOKEN=your_mercado_pago_token
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@cinehub-global.com

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# Video CDN
CDN_BASE_URL=your_cdn_url
VIDEO_STORAGE_BUCKET=videos

# Admin Dashboard
ADMIN_SECRET_KEY=your_admin_secret_key

# Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
